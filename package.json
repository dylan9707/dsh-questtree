{
  "name": "dsh-questtree",
  "version": "0.3.0",
  "description": "Quest tree for DeepSeek Harness: track a long-running task as a main quest + branch tree, break each task into decision questions, interview along that list, and record each ruling plus its implementation preview inline in the sidebar panel.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quest-tree",
    "task-tracking",
    "task-management",
    "todo",
    "ai-agent",
    "llm"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": {
    "name": "dylan9707",
    "url": "https://github.com/dylan9707"
  },
  "homepage": "https://github.com/dylan9707/dsh-questtree#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dylan9707/dsh-questtree.git"
  },
  "bugs": {
    "url": "https://github.com/dylan9707/dsh-questtree/issues"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --input-type=module -e \"import('./lib/index.js').then(m => console.log('OK: ' + Object.keys(m).join(', ')))\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-client-ui-sidebar-right": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
